# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# --- IA local (Ollama) — gratuita, sem conta e sem limite -----------------
# 1. Instale: https://ollama.com/download
# 2. No terminal: ollama pull qwen2.5:3b
# Se o Ollama estiver fechado, a automação usa o plano B por regras e continua.
USAR_IA=sim
OLLAMA_URL=http://localhost:11434
MODELO_IA=qwen2.5:3b
CONFIANCA_MINIMA=0.6

# --- Caixa que RECEBE os pedidos (IMAP) ----------------------------------
# Gmail: ative a verificação em 2 etapas e crie uma "Senha de app" (16 letras).
IMAP_HOST=imap.gmail.com
IMAP_USUARIO=
IMAP_SENHA=
IMAP_PASTA=INBOX

# --- ENVIO do encaminhamento (SMTP) --------------------------------------
# Sem SMTP_HOST e SMTP_USUARIO, o e-mail é salvo em saida/emails/PROTOCOLO.eml.
# Para enviar pelo Gmail: SMTP_HOST=smtp.gmail.com
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# Modo demonstração: os responsáveis da tabela são fictícios. Coloque aqui o
# e-mail que vai receber TODOS os encaminhamentos durante o vídeo.
EMAIL_DEMO_PARA=

INTERVALO_SEGUNDOS=30
